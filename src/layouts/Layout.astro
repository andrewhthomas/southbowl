---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SeasonPicker from '../components/SeasonPicker.astro';
import { currentSeason, navItems, seasons, seasonHref, type Season } from '../data/seasons';
import CommandPalette, { type PaletteItem } from '../components/CommandPalette';
import { navIcons, toSlug } from '../lib/utils';

interface Props {
  season: Season;
  title?: string;
  activeNav?: string;
}

const { season, activeNav = '/' } = Astro.props;
const { league } = season;
const title = Astro.props.title ?? league.name;
const href = (path: string) => seasonHref(season, path);

// Everything the command palette can jump to, flattened at build time so the
// island ships labels and URLs rather than the whole season.
const paletteItems: PaletteItem[] = [
  ...navItems.map(item => ({ group: 'Pages', label: item.label, href: href(item.href) })),
  ...season.bowlers.map(b => ({
    group: 'Bowlers',
    label: b.name,
    sub: b.team,
    href: href(`/bowlers/${toSlug(b.name)}`),
  })),
  ...season.standings.map(t => ({
    group: 'Teams',
    label: t.name,
    sub: `#${t.num}`,
    href: href(`/teams#team-${t.num}`),
  })),
  ...season.weekRecaps.map(r => ({
    group: 'Weeks',
    label: `Week ${r.week}`,
    sub: r.date,
    href: href(`/recaps/${r.week}`),
  })),
  ...seasons.map(s => ({ group: 'Seasons', label: s.label, href: seasonHref(s, activeNav) })),
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- viewport-fit=cover is what makes env(safe-area-inset-*) resolve to anything.
         No apple-mobile-web-app-status-bar-style: the default leaves the status bar
         opaque and tinted from theme-color, which stays readable in both themes. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Kept in sync with the active theme by applyTheme() below -->
    <meta name="theme-color" content="#09090b" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Southbowl" />
    <title>{title}{!season.isCurrent && ` (${season.label})`} | {league.center}</title>
    <ClientRouter />
    <!-- Prevent flash: apply the theme before paint, and again after every view
         transition, since the swap copies <html> attributes from the incoming
         page and would drop the .light class. This script is identical on every
         page, so the router never re-runs it and the listener is added once. -->
    <script is:inline>
      (function() {
        function applyTheme() {
          const light = (localStorage.getItem('theme') || 'dark') === 'light';
          document.documentElement.classList.toggle('light', light);
          // Matches the installed app's status bar to the theme
          document.querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', light ? '#fafafa' : '#09090b');
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
    <script>
      // Runs once: registering an already-registered worker is a no-op anyway.
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      }
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <!-- Mobile header -->
    <header class="lg:hidden border-b border-border bg-card py-3 px-safe">
      <div class="flex items-center justify-between">
        <div class="min-w-0">
          <a href={href('/')}>
            <h1 class="text-lg font-bold text-primary">{league.center}</h1>
          </a>
          <SeasonPicker season={season} activeNav={activeNav} compact />
        </div>
        <div class="flex items-center gap-1">
          <button id="palette-open-mobile" class="p-2 rounded-md hover:bg-secondary text-muted-foreground hover:text-foreground transition-colors" aria-label="Search">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="8" />
              <path stroke-linecap="round" d="m21 21-4.3-4.3" />
            </svg>
          </button>
          <button id="theme-toggle-mobile" class="p-2 rounded-md hover:bg-secondary text-muted-foreground hover:text-foreground transition-colors" aria-label="Toggle theme">
            <!-- Sun icon (shown in dark mode) -->
            <svg class="w-5 h-5 theme-icon-sun" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <!-- Moon icon (shown in light mode) -->
            <svg class="w-5 h-5 theme-icon-moon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <div class="flex">
      <!-- Desktop sidebar -->
      <aside class="hidden lg:flex lg:flex-col lg:w-64 lg:min-h-screen border-r border-border bg-card">
        <div class="p-6 border-b border-border">
          <div class="flex items-center justify-between">
            <a href={href('/')}><h1 class="text-xl font-bold text-primary hover:underline">{league.center}</h1></a>
            <button id="theme-toggle-desktop" class="p-1.5 rounded-md hover:bg-secondary text-muted-foreground hover:text-foreground transition-colors" aria-label="Toggle theme">
              <svg class="w-4 h-4 theme-icon-sun" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
              <svg class="w-4 h-4 theme-icon-moon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
              </svg>
            </button>
          </div>
          <div class="mt-3">
            <SeasonPicker season={season} activeNav={activeNav} />
          </div>
          <button
            id="palette-open-desktop"
            class="mt-3 w-full flex items-center gap-2 bg-secondary border border-border rounded-md px-3 py-2 text-sm text-muted-foreground hover:text-foreground hover:bg-secondary/80 transition-colors"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="8" />
              <path stroke-linecap="round" d="m21 21-4.3-4.3" />
            </svg>
            <span class="flex-1 text-left">Search</span>
            <kbd class="text-[10px] border border-border rounded px-1 py-0.5">&#8984;K</kbd>
          </button>
          <div class="mt-3 space-y-1 text-xs text-muted-foreground">
            <p>{league.address}</p>
            <p>{league.phone}</p>
            <p>{league.day}s at {league.time}</p>
            <p>Updated: {league.lastUpdated}</p>
          </div>
        </div>
        <nav class="flex-1 p-4">
          <ul class="space-y-1">
            {navItems.map(item => (
              <li>
                <a
                  href={href(item.href)}
                  data-astro-prefetch="viewport"
                  class:list={[
                    'block px-3 py-2.5 rounded-md text-sm font-medium transition-colors',
                    activeNav === item.href
                      ? 'bg-primary text-primary-foreground'
                      : 'text-muted-foreground hover:bg-secondary hover:text-foreground',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="flex justify-center py-3">
          <svg class="w-12 h-12 text-muted-foreground/30" viewBox="0 0 640 640" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M240 576C125.1 576 32 482.9 32 368C32 253.1 125.1 160 240 160C354.9 160 448 253.1 448 368C448 482.9 354.9 576 240 576zM496 64C535.8 64 568 96.2 568 136L568 140.4C568 147.2 567.4 153.9 566.2 160.6L564.8 167.2L555.4 204.6C553.2 213.5 552.1 222.6 552.1 231.8L552.1 237.3C552.1 252.7 555.3 268.1 561.5 282.2L592.3 352.6C602.7 376.4 608.1 402.1 608.1 428.1C608.1 459.6 600.2 490.6 585.1 518.3L560.4 563.6C556.2 571.3 548.1 576.1 539.3 576.1L452.8 576.1C445.1 576.1 438 572.4 433.5 566.3L431.7 563.6L422.8 547.3C430.8 539.2 438.2 530.5 445.1 521.4L457.5 544.2L534.5 544.2L556.9 503.1C569.4 480.1 576 454.4 576 428.3C576 406.7 571.6 385.4 562.9 365.6L532.1 295.2C526.7 282.8 523.1 269.7 521.3 256.3L470.3 256.3C461.2 237.5 449.8 220.1 436.5 204.2L427.3 167.4C425.1 158.6 424 149.6 424 140.6L424 136.2C424 96.4 456.2 64.2 496 64.2zM240 192C142.8 192 64 270.8 64 368C64 465.2 142.8 544 240 544C337.2 544 416 465.2 416 368C416 270.8 337.2 192 240 192zM232 352C218.7 352 208 341.3 208 328C208 314.7 218.7 304 232 304C245.3 304 256 314.7 256 328C256 341.3 245.3 352 232 352zM152 336C138.7 336 128 325.3 128 312C128 298.7 138.7 288 152 288C165.3 288 176 298.7 176 312C176 325.3 165.3 336 152 336zM232 272C218.7 272 208 261.3 208 248C208 234.7 218.7 224 232 224C245.3 224 256 234.7 256 248C256 261.3 245.3 272 232 272zM496 96C473.9 96 456 113.9 456 136L456 140.4C456 146.8 456.8 153.2 458.3 159.4L467.6 196.9C469.8 205.8 471.2 214.9 471.7 224.1L520.2 224.1C520.7 214.9 522 205.8 524.3 196.9L533.6 159.4L534.6 154.7C535.5 150 535.9 145.2 535.9 140.4L535.9 136C535.9 113.9 518 96 495.9 96z"/>
          </svg>
        </div>
        <div class="px-4 pb-4 border-t border-border pt-3 text-xs text-muted-foreground">
          {league.leagueId && <p>League #{league.leagueId}</p>}
          <p>Season {season.isCurrent ? 'starts' : 'started'} {league.startDate}</p>
        </div>
      </aside>

      <!-- Main content -->
      <main class="flex-1 min-h-screen safe-x">
        <div class="p-4 lg:p-8 max-w-7xl pb-tabbar">
          {!season.isCurrent && (
            <div class="mb-6 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 rounded-lg border border-border bg-secondary/40 px-4 py-3 text-sm">
              <p class="text-muted-foreground">
                Viewing a past season: <span class="font-medium text-foreground">{league.name}</span>
              </p>
              <a href={seasonHref(currentSeason, activeNav)} class="font-medium text-primary hover:underline">
                Go to {currentSeason.label} &rarr;
              </a>
            </div>
          )}
          <slot />
        </div>
      </main>
    </div>

    <CommandPalette client:idle items={paletteItems} />

    <!-- Mobile tab bar: every section one tap away, the way an app does it -->
    <nav
      class="lg:hidden fixed bottom-0 inset-x-0 z-40 border-t border-border bg-card/95 backdrop-blur-sm safe-x safe-bottom"
      aria-label="Sections"
    >
      <ul class="grid grid-cols-6">
        {navItems.map(item => (
          <li>
            <a
              href={href(item.href)}
              data-astro-prefetch="viewport"
              aria-current={activeNav === item.href ? 'page' : undefined}
              class:list={[
                'flex flex-col items-center gap-0.5 px-0.5 pt-2 pb-1.5 text-[10px] font-medium transition-colors',
                activeNav === item.href
                  ? 'text-primary'
                  : 'text-muted-foreground active:text-foreground',
              ]}
            >
              <Fragment set:html={navIcons[item.href]} />
              <span class="w-full truncate text-center">{item.short}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <script>
      function updateIcons() {
        const isLight = document.documentElement.classList.contains('light');
        document.querySelectorAll('.theme-icon-sun').forEach(el => {
          (el as HTMLElement).style.display = isLight ? 'none' : 'block';
        });
        document.querySelectorAll('.theme-icon-moon').forEach(el => {
          (el as HTMLElement).style.display = isLight ? 'block' : 'none';
        });
      }

      function toggleTheme() {
        const isLight = document.documentElement.classList.toggle('light');
        localStorage.setItem('theme', isLight ? 'light' : 'dark');
        document.querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', isLight ? '#fafafa' : '#09090b');
        updateIcons();
      }

      // Bundled module scripts run once, so every listener on an element has to be
      // re-attached after the router swaps in a new page. astro:page-load fires on
      // the first load and after each navigation.
      function bindPage() {
        document.getElementById('theme-toggle-desktop')?.addEventListener('click', toggleTheme);
        document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);

        const openPalette = () => document.dispatchEvent(new CustomEvent('palette:open'));
        document.getElementById('palette-open-desktop')?.addEventListener('click', openPalette);
        document.getElementById('palette-open-mobile')?.addEventListener('click', openPalette);

        updateIcons();
      }

      document.addEventListener('astro:page-load', bindPage);
    </script>
  </body>
</html>
