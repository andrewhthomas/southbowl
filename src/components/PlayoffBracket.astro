---
import type { PlayoffRound } from '../data/seasons';

interface Props {
  rounds: PlayoffRound[];
  champion?: string | null;
}

const { rounds, champion } = Astro.props;

// Written out so Tailwind sees the class names
const columns: Record<number, string> = {
  1: 'md:grid-cols-1',
  2: 'md:grid-cols-2',
  3: 'md:grid-cols-3',
  4: 'md:grid-cols-4',
};
const colClass = columns[Math.min(rounds.length, 4)] ?? 'md:grid-cols-4';
---

<div class="bg-card border border-border rounded-lg mb-6">
  <div class="px-4 py-3 border-b border-border flex flex-wrap items-center justify-between gap-2">
    <h3 class="font-semibold">Playoffs</h3>
    {champion && (
      <span class="inline-flex items-center gap-1.5 text-sm">
        <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 21h8m-4 0v-4m-5-7H5a2 2 0 01-2-2V5h4m10 5h2a2 2 0 002-2V5h-4M7 4h10v5a5 5 0 01-10 0V4z" />
        </svg>
        <span class="text-muted-foreground">Champion:</span>
        <span class="font-semibold text-primary">{champion}</span>
      </span>
    )}
  </div>

  <div class:list={['p-4 grid gap-4', colClass]}>
    {rounds.map(round => (
      <div>
        <div class="mb-2 flex items-baseline justify-between gap-2">
          <h4 class="text-sm font-semibold">{round.title}</h4>
          <span class="text-[11px] text-muted-foreground font-mono">Wk {round.week}</span>
        </div>
        <div class="space-y-2">
          {round.matches.map(match => (
            <div class="rounded-md border border-border/70 overflow-hidden">
              {[
                { team: match.team1, score: match.score1 },
                { team: match.team2, score: match.score2 },
              ].map(side => (
                <div
                  class:list={[
                    'flex items-center justify-between gap-2 px-3 py-2 text-sm border-b border-border/50 last:border-b-0',
                    side.team === match.winner
                      ? 'bg-primary/10 text-foreground font-medium'
                      : 'text-muted-foreground',
                  ]}
                >
                  <span class="truncate">{side.team}</span>
                  <span class="font-mono text-xs shrink-0">{side.score}</span>
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <p class="px-4 pb-3 text-[11px] text-muted-foreground">
    Each round is a playoff week as bowled, with totals including handicap. The league set the
    pairings, so they do not always follow the previous round's winners.
  </p>
</div>
