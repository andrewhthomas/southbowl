---
import Layout from '../../layouts/Layout.astro';
import BowlerTable from '../../components/BowlerTable';
import { seasonPaths, type Season } from '../../data/seasons';

export function getStaticPaths() {
  return seasonPaths();
}

interface Props {
  season: Season;
}

const { season } = Astro.props;
---

<Layout season={season} title="Bowlers" activeNav="/bowlers">
  <h2 class="text-2xl font-bold mb-6">Bowler List</h2>
  <BowlerTable client:load bowlers={season.bowlers} base={season.base} trends={season.trends} />
</Layout>
