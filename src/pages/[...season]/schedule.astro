---
import Layout from '../../layouts/Layout.astro';
import { seasonHref, seasonPaths, type Season, type WeekResult } from '../../data/seasons';

export function getStaticPaths() {
  return seasonPaths();
}

interface Props {
  season: Season;
}

const { season } = Astro.props;
const { schedule, weekRecaps } = season;

const weeks = [...schedule];
const recapWeeks = new Set(weekRecaps.map(r => r.week));

function isFuture(m: { score1: number; score2: number; wins1: number; wins2: number }) {
  return m.score1 === 0 && m.score2 === 0 && m.wins1 === 0 && m.wins2 === 0;
}

function isWeekFuture(week: WeekResult) {
  return week.matches.length === 0 || week.matches.every(isFuture);
}

// Find the next upcoming Thursday (first future week), fallback to last week
const nextUpcoming = weeks.find(w => isWeekFuture(w));
const defaultWeek = nextUpcoming?.week ?? weeks[weeks.length - 1].week;
---

<Layout season={season} title="Schedule & Results" activeNav="/schedule">
  <h2 class="text-2xl font-bold mb-6">Schedule & Results</h2>

  <div class="flex items-center gap-3 mb-6">
    <select
      id="week-select"
      class="bg-secondary border border-border rounded-md pl-3 pr-8 py-2 text-sm font-medium text-foreground focus:outline-none focus:ring-2 focus:ring-primary appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2216%22%20height%3D%2216%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23a1a1aa%22%20stroke-width%3D%222%22%3E%3Cpath%20d%3D%22M6%209l6%206%206-6%22%2F%3E%3C%2Fsvg%3E')] bg-[length:16px] bg-[position:right_0.5rem_center] bg-no-repeat"
    >
      {weeks.map((week) => (
        <option
          value={week.week}
          selected={week.week === defaultWeek}
        >
          Week {week.week}: {week.date}{isWeekFuture(week) ? ' (Upcoming)' : ''}
        </option>
      ))}
    </select>
    <button
      id="show-all-btn"
      class="bg-secondary border border-border rounded-md px-3 py-2 text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-secondary/80 transition-colors"
    >
      Show All
    </button>
  </div>

  <div id="weeks-container" class="space-y-6" data-default-week={defaultWeek}>
    {weeks.map((week) => {
      const allFuture = isWeekFuture(week);
      return (
        <div
          class:list={['week-card bg-card border border-border rounded-lg', allFuture && 'opacity-75']}
          data-week={week.week}
        >
          <div class="px-4 py-3 border-b border-border flex items-center justify-between">
            <div class="flex items-center gap-2">
              <h3 class="font-semibold">Week {week.week}</h3>
              {allFuture && <span class="text-[10px] bg-secondary text-muted-foreground px-1.5 py-0.5 rounded uppercase font-bold">Upcoming</span>}
              {week.playoff && <span class="text-[10px] bg-primary/20 text-primary px-1.5 py-0.5 rounded uppercase font-bold">Playoff</span>}
            </div>
            <div class="flex items-center gap-3">
              {recapWeeks.has(week.week) && (
                <a href={seasonHref(season, `/recaps/${week.week}`)} class="text-xs text-primary hover:underline font-medium">
                  Full Scoresheet &rarr;
                </a>
              )}
              <span class="text-sm text-muted-foreground">{week.date}</span>
            </div>
          </div>
          {week.matches.length === 0 ? (
            <div class="px-4 py-4 text-sm text-muted-foreground">
              Position Round: matchups determined by standings
            </div>
          ) : (
            <div class="divide-y divide-border/50">
              {week.matches.map((m) => {
                const future = isFuture(m);
                return (
                  <div class="px-4 py-3 flex items-center text-sm">
                    {m.lanes && (
                      <span class="text-[10px] text-muted-foreground font-mono w-10 shrink-0">L{m.lanes[0]}-{m.lanes[1]}</span>
                    )}
                    <div class="flex-1 flex items-center gap-2">
                      <span class:list={[
                        'font-medium',
                        !future && m.wins1 > m.wins2 ? 'text-foreground' : 'text-muted-foreground',
                      ]}>
                        {m.team1}
                      </span>
                      {!future && m.wins1 > m.wins2 && <span class="text-[10px] bg-primary/20 text-primary px-1.5 py-0.5 rounded font-bold">W</span>}
                    </div>
                    {future ? (
                      <span class="text-xs text-muted-foreground bg-secondary px-2 py-1 rounded">vs</span>
                    ) : (
                      <div class="flex items-center gap-3 font-mono text-xs">
                        <span class:list={[m.wins1 > m.wins2 ? 'text-foreground font-bold' : 'text-muted-foreground']}>
                          {m.score1}
                        </span>
                        <span class="text-muted-foreground bg-secondary px-2 py-1 rounded">
                          {m.wins1}-{m.wins2}
                        </span>
                        <span class:list={[m.wins2 > m.wins1 ? 'text-foreground font-bold' : 'text-muted-foreground']}>
                          {m.score2}
                        </span>
                      </div>
                    )}
                    <div class="flex-1 flex items-center gap-2 justify-end">
                      {!future && m.wins2 > m.wins1 && <span class="text-[10px] bg-primary/20 text-primary px-1.5 py-0.5 rounded font-bold">W</span>}
                      <span class:list={[
                        'font-medium',
                        !future && m.wins2 > m.wins1 ? 'text-foreground' : 'text-muted-foreground',
                      ]}>
                        {m.team2}
                      </span>
                    </div>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      );
    })}
  </div>

  <!-- The visible week lives in ?week=, so a given week is linkable and the back
       button walks through the ones you looked at. A bundled module rather than
       define:vars: the router keys inline scripts by their text and skips ones it
       has already run, and two seasons can share a defaultWeek. -->
  <script>
    type Parts = {
      container: HTMLElement;
      cards: HTMLElement[];
      select: HTMLSelectElement | null;
      showAllBtn: HTMLElement | null;
      defaultWeek: number;
    };

    // Queried fresh every time: the router replaces these nodes on each navigation.
    function parts(): Parts | null {
      const container = document.getElementById('weeks-container');
      if (!container) return null; // fires on every page once loaded, not just this one
      return {
        container,
        cards: Array.from(container.querySelectorAll<HTMLElement>('.week-card')),
        select: document.getElementById('week-select') as HTMLSelectElement | null,
        showAllBtn: document.getElementById('show-all-btn'),
        defaultWeek: Number(container.dataset.defaultWeek),
      };
    }

    function weekFromUrl(p: Parts): string {
      const param = new URLSearchParams(location.search).get('week');
      if (param === 'all') return 'all';
      const known = p.cards.some(card => card.dataset.week === param);
      return known && param ? param : String(p.defaultWeek);
    }

    function render() {
      const p = parts();
      if (!p) return;

      const value = weekFromUrl(p);
      const all = value === 'all';
      p.cards.forEach(card => {
        card.style.display = all || card.dataset.week === value ? '' : 'none';
      });
      if (p.select && !all) p.select.value = value;
      if (p.showAllBtn) p.showAllBtn.textContent = all ? 'Show One' : 'Show All';
    }

    function setWeek(value: string) {
      const url = new URL(location.href);
      url.searchParams.set('week', value);
      history.pushState({}, '', url);
      render();
    }

    function bindSchedule() {
      const p = parts();
      if (!p) return;

      p.select?.addEventListener('change', () => setWeek(p.select!.value));
      p.showAllBtn?.addEventListener('click', () => {
        const showingAll = weekFromUrl(p) === 'all';
        setWeek(showingAll ? (p.select?.value ?? String(p.defaultWeek)) : 'all');
      });

      render();
    }

    document.addEventListener('astro:page-load', bindSchedule);
    // Registered once at module scope; render() re-reads the DOM each time.
    window.addEventListener('popstate', render);
  </script>
</Layout>
